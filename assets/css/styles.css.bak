/* TWS Sports Day 2026 - UI/UX Pro Max Enhanced Styles */
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sarabun:wght@400;500;600;700&display=swap');

:root {
  --font-royal: 'Cinzel', serif;
  --font-body: 'Plus Jakarta Sans', 'Sarabun', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  
  /* Techawit School Master Palette */
  --tws-navy: #0B1E36;
  --tws-navy-hover: #162F52;
  --tws-navy-dark: #061120;
  --tws-gold: #C59A3F;
  --tws-gold-light: #FBF6E9;
  --tws-gold-border: #E8D39E;

  /* Surfaces & Elevation */
  --bg-app: #F8FAFC;
  --bg-card: #FFFFFF;
  --border-subtle: #E2E8F0;
  --border-strong: #CBD5E1;
  --text-primary: #0B1E36;
  --text-secondary: #475569;
  --text-muted: #64748B;

  /* Royal House Accents */
  --amethyst-primary: #7C3AED;
  --amethyst-subtle: #FAF5FF;
  --amethyst-border: #E9D5FF;

  --crimson-primary: #DC2626;
  --crimson-subtle: #FEF2F2;
  --crimson-border: #FECACA;

  --golden-primary: #D97706;
  --golden-subtle: #FFFBEB;
  --golden-border: #FEF08A;

  --jade-primary: #059669;
  --jade-subtle: #ECFDF5;
  --jade-border: #A7F3D0;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-app);
  color: var(--text-primary);
  overflow-x: hidden;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

.font-royal {
  font-family: var(--font-royal);
}

/* Micro-interaction & Focus States */
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible {
  outline: 2px solid var(--tws-gold);
  outline-offset: 2px;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}
::-webkit-scrollbar-track {
  background: #F1F5F9;
}
::-webkit-scrollbar-thumb {
  background: #94A3B8;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--tws-navy);
}

/* Interactive Card Elevations */
.interactive-card {
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 180ms cubic-bezier(0.16, 1, 0.3, 1), border-color 180ms ease;
}
.interactive-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px -5px rgba(11, 30, 54, 0.08), 0 8px 10px -6px rgba(11, 30, 54, 0.04);
}
.interactive-card:active {
  transform: translateY(0);
}

/* 4 Kingdom Custom Cards */
.card-amethyst {
  background: #FFFFFF;
  border: 1px solid var(--amethyst-border);
  box-shadow: 0 2px 10px rgba(124, 58, 237, 0.05);
}
.card-amethyst:hover {
  border-color: var(--amethyst-primary);
  box-shadow: 0 12px 28px rgba(124, 58, 237, 0.12);
}

.card-crimson {
  background: #FFFFFF;
  border: 1px solid var(--crimson-border);
  box-shadow: 0 2px 10px rgba(220, 38, 38, 0.05);
}
.card-crimson:hover {
  border-color: var(--crimson-primary);
  box-shadow: 0 12px 28px rgba(220, 38, 38, 0.12);
}

.card-golden {
  background: #FFFFFF;
  border: 1px solid var(--golden-border);
  box-shadow: 0 2px 10px rgba(217, 119, 6, 0.05);
}
.card-golden:hover {
  border-color: var(--golden-primary);
  box-shadow: 0 12px 28px rgba(217, 119, 6, 0.12);
}

.card-jade {
  background: #FFFFFF;
  border: 1px solid var(--jade-border);
  box-shadow: 0 2px 10px rgba(5, 150, 105, 0.05);
}
.card-jade:hover {
  border-color: var(--jade-primary);
  box-shadow: 0 12px 28px rgba(5, 150, 105, 0.12);
}

/* Modal Backdrop */
.modal-backdrop {
  background-color: rgba(6, 17, 32, 0.72);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

/* Clean Professional Table */
.clean-table th {
  background-color: #F8FAFC;
  color: #0B1E36;
  font-weight: 800;
  letter-spacing: 0.05em;
}
.clean-table tr {
  transition: background-color 120ms ease;
}
.clean-table tbody tr:hover {
  background-color: #F1F5F9;
}

/* Mobile Touch & Viewport Polish */
html, body {
  overflow-x: hidden;
  max-width: 100vw;
  -webkit-text-size-adjust: 100%;
}

@media (max-width: 640px) {
  /* Prevent horizontal stretch */
  .countdown-container {
    width: 100% !important;
  }
  .countdown-container > div {
    min-width: 0 !important;
    width: 100% !important;
    padding: 12px !important;
  }
  /* Buttons & Inputs tap targets */
  button, input, select, a {
    min-height: 40px;
  }
  /* Modal responsive on small screens */
  .modal-backdrop > div {
    max-height: 94vh !important;
    width: 95% !important;
    margin: auto !important;
  }
}

/* Dedicated A4 Print Styles */
@media print {
  @page {
    size: A4 portrait;
    margin: 10mm 12mm 10mm 12mm;
  }
  body {
    background-color: #FFFFFF !important;
    color: #000000 !important;
    font-size: 10pt;
    line-height: 1.3;
  }
  .no-print, header, nav, footer, #search-student, .filter-toolbar, .btn-action, .stat-cards-container {
    display: none !important;
  }
  .print-only {
    display: block !important;
  }
  .page-break {
    page-break-after: always;
    break-after: page;
  }
  table {
    width: 100% !important;
    border-collapse: collapse !important;
    font-size: 9pt !important;
  }
  th, td {
    border: 1px solid #CBD5E1 !important;
    padding: 5px 6px !important;
    color: #0B1E36 !important;
  }
  th {
    background-color: #F1F5F9 !important;
    font-weight: 700 !important;
  }
}
