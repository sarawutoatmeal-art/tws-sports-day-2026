      <!-- Master Document Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        
        <!-- Google Doc -->
        <div class="p-5 rounded-2xl bg-white border border-blue-200 shadow-sm flex flex-col justify-between hover:border-blue-400 transition interactive-card">
          <div class="space-y-2">
            <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 font-black font-mono">
              MASTER HANDBOOK
            </span>
            <h3 class="text-base font-bold text-[#0B1E36]">Official Handbook & Program</h3>
