            <p class="text-xs text-slate-500 leading-relaxed">
              Google Sheet color tabs for athlete registration, team audit checking, and printable scorecards 1–8.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100">
            <a 
              href="https://docs.google.com/spreadsheets/d/14oRVn1mb3iiclWVlBbaR_SYpimgUbaXF/edit?gid=181845680#gid=181845680" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs font-bold bg-emerald-700 hover:bg-emerald-800 text-white transition shadow-sm"
            >
              <span>Open Registration Sheet</span> ↗
            </a>
          </div>
        </div>

        <!-- Google Sheet 2 -->
        <div class="p-5 rounded-2xl bg-white border border-purple-200 shadow-sm flex flex-col justify-between hover:border-purple-400 transition interactive-card">
          <div class="space-y-2">
            <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-purple-50 text-purple-700 border border-purple-200 font-black font-mono">
              SCHEDULE & DUTIES
            </span>
            <h3 class="text-base font-bold text-[#0B1E36]">41 Matches & Faculty Duty Sheet</h3>
