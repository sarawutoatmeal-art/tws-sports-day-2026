    <!-- SECTION 6: SPORTS ENTRY HUB & ONLINE DOCS  -->
    <!-- ========================================== -->
    <section id="section-registration" class="tab-content-section hidden space-y-6">
      
      <div class="border-b border-slate-200 pb-5">
        <h2 class="text-2xl font-black font-royal text-[#0B1E36] flex items-center gap-2">
          <span>🔗</span> Master Documents Hub & Sports Quota Matrix
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Direct cloud access to Google Docs, Google Sheets, and color entry quotas (86 student athletes & 13 parent participants per kingdom).
        </p>
