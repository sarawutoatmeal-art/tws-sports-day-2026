          </div>
        </div>

        <!-- Google Sheet 1 -->
        <div class="p-5 rounded-2xl bg-white border border-emerald-200 shadow-sm flex flex-col justify-between hover:border-emerald-400 transition interactive-card">
          <div class="space-y-2">
            <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-black font-mono">
              ATHLETE REGISTRATION
            </span>
