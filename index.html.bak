  <!-- ========================================== -->
  <!-- MODAL: EDIT ATHLETE SPORTS ASSIGNMENT      -->
  <!-- ========================================== -->
  <div id="edit-student-modal" class="fixed inset-0 z-50 modal-backdrop hidden flex items-center justify-center p-4">
    <div class="rounded-2xl bg-white border border-slate-300 w-full max-w-lg shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
      
      <!-- Modal Header -->
      <div class="p-5 border-b border-slate-200 bg-slate-50 flex items-start justify-between">
        <div>
          <span class="text-[11px] font-black uppercase tracking-wider text-[#0B1E36] font-mono">
            Athlete Sport Registration
          </span>
          <h3 id="modal-student-name" class="text-lg font-black text-[#0B1E36] mt-0.5">
            Student Name
          </h3>
          <p id="modal-student-info" class="text-xs text-slate-600 mt-0.5">
            Class Info
          </p>
        </div>
        <button id="btn-close-modal" onclick="closeStudentEditModal()" class="text-slate-400 hover:text-slate-800 p-2 rounded-lg hover:bg-slate-200 text-lg font-bold">
          ✕
        </button>
      </div>

      <!-- Modal Body (Sports Checklist) -->
      <div class="p-5 overflow-y-auto space-y-3 flex-1 bg-white">
        <div class="flex items-center justify-between pb-2 border-b border-slate-100">
          <span class="text-xs font-bold text-[#0B1E36]">Select participating sports:</span>
          <span id="modal-event-count" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-slate-100 text-slate-600 border border-slate-200">
            0 Events
          </span>
        </div>

        <div id="modal-sports-checklist" class="space-y-2">
          <!-- Dynamically populated -->
        </div>

        <p class="text-[11px] text-slate-500 italic pt-2">
          💡 School Directive: Target 1–2 events per student to maximize inclusion while preventing physical fatigue.
        </p>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between gap-3">
        <a id="modal-gsheet-btn" href="https://docs.google.com/spreadsheets/d/14oRVn1mb3iiclWVlBbaR_SYpimgUbaXF/edit" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-emerald-700 hover:bg-emerald-800 text-white shadow-sm transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Open Color Tab in Google Sheets
        </a>
        <div class="flex items-center gap-2">
          <button id="btn-cancel-modal" onclick="closeStudentEditModal()" class="px-4 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 transition">
            Cancel
          </button>
          <button id="btn-save-modal" onclick="saveStudentEditModal()" class="px-5 py-2 rounded-xl text-xs font-bold bg-[#0B1E36] hover:bg-[#162F52] text-white transition shadow-sm">
            💾 Save in Web
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: REFEREE PIN UNLOCK                  -->
  <!-- ========================================== -->
  <div id="referee-pin-modal" class="fixed inset-0 z-50 modal-backdrop hidden flex items-center justify-center p-4">
    <div class="rounded-2xl bg-white border border-slate-300 w-full max-w-sm shadow-2xl overflow-hidden p-6 text-center space-y-4">
      <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-2xl mx-auto shadow-inner">
        🔐
      </div>
      <div>
        <h3 class="text-lg font-black text-[#0B1E36] font-royal">ปลดล็อกโหมดผู้ตัดสิน (Referee Mode)</h3>
        <p class="text-xs text-slate-500 mt-1">กรุณากรอกรหัส PIN 4 หลักของคณะกรรมการตัดสิน เพื่อเปิดสิทธิ์การบันทึกผลและแก้ไขคะแนน</p>
      </div>

      <div class="space-y-2">
        <input 
          id="referee-pin-input" 
          type="password" 
          inputmode="numeric" 
          maxlength="6" 
          placeholder="••••" 
          class="w-full text-center text-2xl tracking-[0.3em] font-mono py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0B1E36]"
        />
        <div id="referee-pin-error" class="hidden text-xs font-bold text-rose-600">
          ⚠️ รหัส PIN ไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <button id="btn-cancel-pin-modal" class="w-1/2 py-2.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
          ยกเลิก
        </button>
        <button id="btn-submit-pin" class="w-1/2 py-2.5 rounded-xl text-xs font-bold bg-[#0B1E36] hover:bg-[#162F52] text-white transition shadow-sm">
          ยืนยันรหัส
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: RECORD EVENT RESULT (GOLD/SILVER/BRONZE) -->
  <!-- ========================================== -->
  <div id="record-result-modal" class="fixed inset-0 z-50 modal-backdrop hidden flex items-center justify-center p-4">
    <div class="rounded-2xl bg-white border border-slate-300 w-full max-w-md shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
      <!-- Header -->
      <div class="p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <div>
          <h3 class="text-base font-black text-[#0B1E36] font-royal flex items-center gap-2">
            <span>🏅</span> บันทึกผลผู้ชนะกีฬา
          </h3>
          <p id="modal-result-event-name" class="text-xs text-slate-500 font-bold mt-0.5">30m Sprint - G.1 Boys Heat 1</p>
        </div>
        <button id="btn-close-result-modal" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200 transition">
          ✕
        </button>
      </div>

      <!-- Body Form -->
      <div class="p-5 space-y-4 overflow-y-auto">
        <input type="hidden" id="modal-result-event-id" value="" />

        <!-- Gold (1st Place) -->
        <div>
          <label class="block text-xs font-black text-amber-600 mb-1 flex items-center gap-1.5">
            <span>🥇</span> เหรียญทอง (อันดับ 1 - 5 คะแนน):
          </label>
          <select id="select-winner-gold" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
            <option value="">-- ยังไม่มีผล --</option>
            <option value="Purple">💜 สีม่วง (Amethyst Kingdom)</option>
            <option value="Red">❤️ สีแดง (Crimson Empire)</option>
            <option value="Yellow">💛 สีเหลือง (Golden Realm)</option>
            <option value="Green">💚 สีเขียว (Jade Dynasty)</option>
          </select>
        </div>

        <!-- Silver (2nd Place) -->
        <div>
          <label class="block text-xs font-black text-slate-600 mb-1 flex items-center gap-1.5">
            <span>🥈</span> เหรียญเงิน (อันดับ 2 - 3 คะแนน):
          </label>
          <select id="select-winner-silver" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-500">
            <option value="">-- ยังไม่มีผล --</option>
            <option value="Purple">💜 สีม่วง (Amethyst Kingdom)</option>
            <option value="Red">❤️ สีแดง (Crimson Empire)</option>
            <option value="Yellow">💛 สีเหลือง (Golden Realm)</option>
            <option value="Green">💚 สีเขียว (Jade Dynasty)</option>
          </select>
        </div>

        <!-- Bronze (3rd Place) -->
        <div>
          <label class="block text-xs font-black text-amber-800 mb-1 flex items-center gap-1.5">
            <span>🥉</span> เหรียญทองแดง (อันดับ 3 - 1 คะแนน):
          </label>
          <select id="select-winner-bronze" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-800">
            <option value="">-- ยังไม่มีผล --</option>
            <option value="Purple">💜 สีม่วง (Amethyst Kingdom)</option>
            <option value="Red">❤️ สีแดง (Crimson Empire)</option>
            <option value="Yellow">💛 สีเหลือง (Golden Realm)</option>
            <option value="Green">💚 สีเขียว (Jade Dynasty)</option>
          </select>
        </div>
      </div>

      <!-- Footer -->
      <div class="p-4 border-t border-slate-200 bg-slate-50 flex items-center justify-end gap-2">
        <button id="btn-cancel-result-modal" class="px-4 py-2 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition">
          Cancel
        </button>
        <button id="btn-save-result-modal" class="px-5 py-2 rounded-xl text-xs font-bold bg-[#0B1E36] hover:bg-[#162F52] text-white transition shadow-sm">
          💾 บันทึกผลคะแนน
        </button>
      </div>
    </div>
  </div>

  <!-- Dedicated Print Render Area (Injected only during print) -->
