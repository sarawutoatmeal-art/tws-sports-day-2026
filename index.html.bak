            >
              <span>Open Schedule & Duty Sheet</span> ↗
            </a>
          </div>
        </div>

      </div>

      <!-- Sports Quota Matrix -->
      <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm space-y-4">
        <div class="p-4 bg-slate-50 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
