<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TWS Sports Day 2026: Kingdom Games | Techawit School Teacher Portal</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Custom Styles -->
  <link rel="stylesheet" href="assets/css/styles.css">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            kingdom: {
              crimson: '#dc2626',
              golden: '#d97706',
              jade: '#059669',
              amethyst: '#7c3aed'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#F8FAFC] text-[#0B1E36] min-h-screen flex flex-col antialiased selection:bg-[#0B1E36] selection:text-white">

  <!-- Top Announcement Bar (Official Techawit Navy & Gold) -->
  <div class="bg-[#0B1E36] text-white px-4 py-2.5 text-xs font-bold text-center tracking-wider uppercase flex flex-wrap items-center justify-center gap-3 border-b border-[#C59A3F]/30 shadow-sm">
    <span class="inline-flex items-center gap-1.5 text-[#F4E7BD]">
      <span class="w-2 h-2 rounded-full bg-[#C59A3F] animate-pulse"></span>
      TECHAWIT SCHOOL OFFICIAL PORTAL
    </span>
    <span class="text-slate-400 hidden sm:inline">•</span>
    <span class="text-white/90">Event Date: Friday, January 8, 2027 (8 ม.ค. 2570)</span>
    <span class="text-slate-400 hidden md:inline">•</span>
    <span class="text-[#F4E7BD]">Primary Campus • 232 Student Athletes</span>
    <span class="text-slate-400 hidden lg:inline">•</span>
    <span id="autosave-indicator" class="opacity-0 transition-opacity duration-300 text-[#0B1E36] bg-[#F4E7BD] px-2.5 py-0.5 rounded text-[10px] font-bold">
      DATABASE SYNCED
    </span>
  </div>

  <!-- Header & Hero Section (Clean White with Navy Accents & School Crest) -->
  <header class="relative border-b border-slate-200 bg-white shadow-sm overflow-hidden no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        
        <!-- School Crest & Official Branding -->
        <div class="flex flex-col sm:flex-row items-center lg:items-start gap-5 text-center sm:text-left">
          <div class="relative shrink-0 p-1.5 rounded-2xl bg-white border border-slate-200 shadow-md">
            <img 
              src="assets/images/tws-logo.png" 
              alt="Techawit School Logo โรงเรียนเตชะวิทย์" 
              class="w-24 h-24 sm:w-28 sm:h-28 object-contain"
              onerror="this.style.display='none'"
            />
          </div>

          <div class="space-y-2.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-[#0B1E36] text-xs font-black tracking-wider uppercase">
              <span>TECHAWIT SCHOOL (โรงเรียนเตชะวิทย์)</span>
            </div>
            
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black font-royal tracking-tight text-[#0B1E36]">
              TWS SPORTS DAY <span class="text-[#C59A3F]">2026</span>
            </h1>
            <p class="text-base sm:text-lg font-black font-royal text-[#0B1E36] tracking-widest uppercase flex items-center justify-center sm:justify-start gap-2">
              <span>⚔️</span> THE KINGDOM GAMES <span>⚔️</span>
            </p>
            <p class="text-xs sm:text-sm text-slate-600 max-w-xl leading-relaxed">
              Official faculty & staff portal for Techawit Primary Sports Day. Access 232 student rosters, 13 teacher duty departments, official time schedules, handbook medals, and A4 print center.
            </p>

            <!-- 4 Kingdom Badges Quick Preview -->
            <div class="pt-1 flex flex-wrap items-center justify-center sm:justify-start gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-200">
                🦁 Crimson Empire
              </span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                ☀️ Golden Realm
              </span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                🐉 Jade Dynasty
              </span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                💎 Amethyst Kingdom
              </span>
            </div>
          </div>
        </div>

        <!-- Official Countdown Card -->
        <div class="countdown-container w-full lg:w-auto">
          <div class="p-5 rounded-2xl bg-white border-2 border-slate-200 shadow-md text-center space-y-3 min-w-[320px]">
            <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-2.5">
              <span class="text-xs font-black uppercase tracking-wider text-[#0B1E36] flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                Event Countdown
              </span>
              <span class="text-xs font-mono font-bold text-slate-500">Jan 8, 2027 • 08:00 AM</span>
            </div>

            <!-- Countdown Digits -->
            <div id="countdown-wrapper" class="grid grid-cols-4 gap-2 text-center">
              <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 min-w-[60px]">
                <div id="count-days" class="text-2xl sm:text-3xl font-black text-[#0B1E36] font-mono">00</div>
                <div class="text-[10px] uppercase font-bold text-slate-500 mt-0.5">Days</div>
              </div>
              <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 min-w-[60px]">
                <div id="count-hours" class="text-2xl sm:text-3xl font-black text-[#0B1E36] font-mono">00</div>
                <div class="text-[10px] uppercase font-bold text-slate-500 mt-0.5">Hours</div>
              </div>
              <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 min-w-[60px]">
                <div id="count-mins" class="text-2xl sm:text-3xl font-black text-[#0B1E36] font-mono">00</div>
                <div class="text-[10px] uppercase font-bold text-slate-500 mt-0.5">Mins</div>
              </div>
              <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 min-w-[60px]">
                <div id="count-secs" class="text-2xl sm:text-3xl font-black text-[#0B1E36] font-mono">00</div>
                <div class="text-[10px] uppercase font-bold text-slate-500 mt-0.5">Secs</div>
              </div>
            </div>

            <div class="flex items-center justify-center gap-2 pt-1">
              <button onclick="switchTab('print')" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-[#0B1E36] text-white hover:bg-[#162F52] transition shadow-sm">
                🖨️ A4 Print Center
              </button>
              <a href="https://docs.google.com/document/d/1YtgJjH1ALr8UXKCoVgftZMUUhPJmnTZOV7QX4cBDgGg/edit?tab=t.0" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-100 text-slate-800 hover:bg-slate-200 border border-slate-200 transition">
                <span>Handbook Doc</span> ↗
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Navigation Tabs Bar (English Primary) -->
    <div class="border-t border-slate-200 bg-white sticky top-0 z-30 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center space-x-1 sm:space-x-2 overflow-x-auto py-2.5 no-scrollbar" aria-label="Main Navigation">
          
          <button data-tab-target="roster" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border transition whitespace-nowrap bg-[#0B1E36] text-white border-[#0B1E36] shadow-sm">
            <span>🏰</span> Student Rosters (232)
          </button>

          <button data-tab-target="scoreboard" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>🏆</span> Live Scoreboard (สรุปคะแนนสด)
          </button>

          <button data-tab-target="callroom" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>📢</span> Call Room (คิวเรียกตัวนักกีฬา)
          </button>

          <button data-tab-target="siblings" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>👥</span> Sibling Directory (ค้นหาพี่น้อง)
          </button>

          <button data-tab-target="print" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>🖨️</span> A4 Print Center
          </button>

          <button data-tab-target="duties" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>📋</span> Teacher Duties & Staff
          </button>

          <button data-tab-target="schedule" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>⏱️</span> Official Schedule
          </button>

          <button data-tab-target="handbook" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>🏅</span> Handbook & 186 Medals
          </button>

          <button data-tab-target="registration" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>🔗</span> Sports & Document Hub
          </button>

          <button data-tab-target="kingdoms" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-transparent text-slate-700 hover:text-[#0B1E36] hover:bg-slate-100 transition whitespace-nowrap">
            <span>👑</span> 4 Royal Kingdoms
          </button>

        </nav>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- ========================================== -->
    <!-- SECTION 1: ATHLETE ROSTERS & DATABASE      -->
    <!-- ========================================== -->
    <section id="section-roster" class="tab-content-section space-y-6">
      
      <!-- Top Title & Roster Stats Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
          <h2 class="text-2xl font-black font-royal text-[#0B1E36] flex items-center gap-2">
            <span>⚔️</span> Student Athlete Rosters & Database (232 Students)
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            4 Kingdom Houses (58 athletes per house) • Click any student or press <strong>"✏️ Assign Event"</strong> to manage participation status.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button id="btn-export-csv" class="btn-action inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm transition">
            📥 Download CSV
          </button>
          <button id="btn-backup-json" class="btn-action inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm transition">
            💾 Backup JSON
          </button>
          <label class="btn-action inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm transition cursor-pointer">
            📤 Restore JSON
            <input type="file" id="input-restore-json" accept=".json" class="hidden" />
          </label>
          <button id="btn-reset-roster" class="btn-action inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 transition">
            🔄 Reset All to 0
          </button>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="stat-cards-container grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
          <span class="text-xs text-slate-500 uppercase font-bold">Total Students</span>
          <div id="stat-total-students" class="text-2xl font-black text-[#0B1E36] font-mono mt-1">232</div>
          <span class="text-[11px] text-slate-500 font-medium">11 Classrooms (G1–G6)</span>
        </div>

        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
          <span class="text-xs text-slate-500 uppercase font-bold">Assigned Athletes</span>
          <div id="stat-assigned-students" class="text-2xl font-black text-emerald-600 font-mono mt-1">0 / 232</div>
          <span class="text-[11px] text-emerald-600 font-medium">Has ≥ 1 Event</span>
        </div>

        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
          <span class="text-xs text-slate-500 uppercase font-bold">Unassigned</span>
          <div id="stat-zero-students" class="text-2xl font-black text-rose-600 font-mono mt-1">232</div>
          <span class="text-[11px] text-rose-600 font-medium">Awaiting Sport Entry</span>
        </div>

        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
          <span class="text-xs text-slate-500 uppercase font-bold">Participation Rate</span>
          <div id="stat-participation-rate" class="text-2xl font-black text-[#0B1E36] font-mono mt-1">0%</div>
          <span class="text-[11px] text-slate-500 font-medium">Target: 100% Inclusion</span>
        </div>
      </div>

      <!-- Kingdom Color Filter Selector Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <!-- Amethyst -->
        <button data-color-filter="Purple" class="text-left p-4 rounded-xl bg-purple-50/70 border border-purple-200 hover:border-purple-400 transition shadow-sm group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-purple-700">AMETHYST</span>
            <span id="badge-count-purple" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-purple-200 text-purple-800">0/58</span>
          </div>
          <div class="text-base font-black font-royal text-purple-900 mt-1">สีม่วง (Purple)</div>
          <div class="text-[11px] text-purple-700 mt-0.5">Imagination • Wisdom</div>
        </button>

        <!-- Crimson -->
        <button data-color-filter="Red" class="text-left p-4 rounded-xl bg-red-50/70 border border-red-200 hover:border-red-400 transition shadow-sm group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-red-700">CRIMSON</span>
            <span id="badge-count-red" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-red-200 text-red-800">0/58</span>
          </div>
          <div class="text-base font-black font-royal text-red-900 mt-1">สีแดง (Red)</div>
          <div class="text-[11px] text-red-700 mt-0.5">Courage • Honor</div>
        </button>

        <!-- Golden -->
        <button data-color-filter="Yellow" class="text-left p-4 rounded-xl bg-amber-50/70 border border-amber-200 hover:border-amber-400 transition shadow-sm group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-800">GOLDEN</span>
            <span id="badge-count-yellow" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-200 text-amber-900">0/58</span>
          </div>
          <div class="text-base font-black font-royal text-amber-950 mt-1">สีเหลือง (Yellow)</div>
          <div class="text-[11px] text-amber-800 mt-0.5">Hope • Energy</div>
        </button>

        <!-- Jade -->
        <button data-color-filter="Green" class="text-left p-4 rounded-xl bg-emerald-50/70 border border-emerald-200 hover:border-emerald-400 transition shadow-sm group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-700">JADE</span>
            <span id="badge-count-green" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-emerald-200 text-emerald-800">0/58</span>
          </div>
          <div class="text-base font-black font-royal text-emerald-900 mt-1">สีเขียว (Green)</div>
          <div class="text-[11px] text-emerald-700 mt-0.5">Wisdom • Harmony</div>
        </button>
      </div>

      <!-- Filter Controls & Search Toolbar -->
      <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm space-y-3 filter-toolbar">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          
          <!-- Search Input -->
          <div class="lg:col-span-2">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Search Nickname / Full Name</label>
            <input 
              type="text" 
              id="search-student" 
              placeholder="Search by nickname (e.g., Ryu, Glacier, Milin) or full name..." 
              class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-[#0B1E36] placeholder-slate-400 focus:outline-none focus:border-[#0B1E36] focus:bg-white transition"
            />
          </div>

          <!-- Class Filter -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Grade / Class</label>
            <select id="filter-class" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-[#0B1E36] focus:outline-none focus:border-[#0B1E36] focus:bg-white transition">
              <option value="all">All Classes (11 Classes)</option>
              <option value="G1 Giraffe">G1 Giraffe (23 students)</option>
              <option value="G1 Beaver">G1 Beaver (24 students)</option>
              <option value="G2 Zebra">G2 Zebra (22 students)</option>
              <option value="G2 Kangaroo">G2 Kangaroo (22 students)</option>
              <option value="G3 Eagle">G3 Eagle (22 students)</option>
              <option value="G3 Falcon">G3 Falcon (22 students)</option>
              <option value="G4 Leopard">G4 Leopard (22 students)</option>
              <option value="G4 Panther">G4 Panther (23 students)</option>
              <option value="G5 Liger">G5 Liger (14 students)</option>
              <option value="G5 Tigon">G5 Tigon (14 students)</option>
              <option value="G6 Phoenix">G6 Phoenix (24 students)</option>
            </select>
          </div>

          <!-- Gender Filter -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Gender</label>
            <select id="filter-gender" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-[#0B1E36] focus:outline-none focus:border-[#0B1E36] focus:bg-white transition">
              <option value="all">All (Boys & Girls)</option>
              <option value="Boy">Boys (Master)</option>
              <option value="Girl">Girls (Miss)</option>
            </select>
          </div>

          <!-- Status Filter -->
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Registration Status</label>
            <select id="filter-status" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-[#0B1E36] focus:outline-none focus:border-[#0B1E36] focus:bg-white transition">
              <option value="all">All Statuses</option>
              <option value="zero">⚠️ Unregistered (0 events)</option>
              <option value="one">Registered (1 event)</option>
              <option value="two">✓ Target Met (2 events)</option>
              <option value="three_plus">⚡ Multi-event (3+ events)</option>
            </select>
          </div>

        </div>

        <div class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-100">
          <div id="roster-match-count" class="font-mono font-bold text-slate-700">Showing 232 students</div>
          <button data-color-filter="all" class="text-[#0B1E36] hover:underline font-bold">
            Show All 4 Kingdoms
          </button>
        </div>
      </div>

      <!-- Students Table & Mobile Card View (White & Navy Theme) -->
      <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
        <!-- Desktop Table View (Hidden on mobile) -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left border-collapse clean-table">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-[11px] uppercase font-black tracking-wider text-[#0B1E36]">
                <th class="py-3 px-3 text-center w-12">#</th>
                <th class="py-3 px-3 w-32">Kingdom / Color</th>
                <th class="py-3 px-3 w-36">Class & No.</th>
                <th class="py-3 px-3">Student Full Name</th>
                <th class="py-3 px-3 w-28">Nickname</th>
                <th class="py-3 px-3">Assigned Events</th>
                <th class="py-3 px-3 text-center w-40">Status & Action</th>
              </tr>
            </thead>
            <tbody id="students-table-body" class="divide-y divide-slate-100 text-sm">
              <!-- Dynamically populated by app.js -->
            </tbody>
          </table>
        </div>

        <!-- Mobile Athlete Cards List (Optimized for Phones) -->
        <div id="students-mobile-list" class="block md:hidden divide-y divide-slate-100 p-2 space-y-2.5">
          <!-- Dynamically populated by app.js for mobile phones -->
        </div>
      </div>

    </section>

    <!-- ========================================== -->
    <!-- SECTION: LIVE SCOREBOARD & MEDAL TALLY     -->
    <!-- ========================================== -->
    <section id="section-scoreboard" class="tab-content-section hidden space-y-6">
      
      <!-- Scoreboard Header -->
      <div class="border-b border-slate-200 pb-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
